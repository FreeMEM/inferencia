# Conversación con un proveedor con el formato de OpenAI Chat Completions (OpenRouter, OpenAI, Ollama...),
# con herramientas.
#
#   c = conv_nueva("Eres Inferencia, un asistente en un Amiga.")
#   conv_herramienta(c, "leer", "Lee un fichero", "{\"type\":\"object\",\"properties\":{...}}")
#   conv_usuario(c, "¿Qué hay en S:Startup-Sequence?")
#   t = conv_pedir(c, cfg)                      # esperando; sin esperar: conv_empezar y conv_acabar
#   for l in t.llamadas                         # el modelo quiere usar herramientas
#       conv_resultado(c, l.id, ejecutar(l))    # el resultado de cada una, y conv_pedir otra vez
#   end
#   Print t.texto                               # cuando t.llamadas está vacía, la respuesta
#
# Dentro, todo va en UTF-8, como la API. Lo que escribe el usuario (Latin-1) pasa por conv_usuario; t.texto y
# los argumentos de las llamadas (llamada_str) vuelven en Latin-1.

import "lib/red/http.dash"
import "lib/json.dash"
import "config.dash"

const ESPERA_PETICION = 300000

struct Conversacion
    mensajes: Json        # la lista de mensajes, tal como va a la API
    herramientas: Json    # la lista de herramientas (formato "function")
end

struct Llamada
    id: String
    nombre: String
    argumentos: Json      # el objeto de argumentos; vacío si el modelo mandó algo que no es JSON
    crudo: String         # los argumentos tal como llegaron (UTF-8)
end

struct Turno
    texto: String         # lo que dice el modelo, en Latin-1
    llamadas: [Llamada]   # las herramientas que quiere usar (vacía si ha acabado)
    fin: String           # finish_reason: "stop", "tool_calls", "length"...
    modelo: String
    entrada: Int          # tokens de entrada y de salida de este turno
    salida: Int
    error: String         # "" si fue bien
    coste: Int            # lo que costó, en millonésimas de dólar (usage.cost de OpenRouter; 0 si no lo dice)
end

func conv_nueva(sistema: String) -> Conversacion
    c = Conversacion(json_array(), json_array())
    if sistema != ""
        _conv_mensaje(c, "system", latin1_to_utf8(sistema))
    end
    return c
end

func _conv_mensaje(c: Conversacion, rol: String, texto: String)
    m = json_object()
    json_set_str(m, "role", rol)
    json_set_str(m, "content", texto)
    json_push(c.mensajes, m)
end

# Una herramienta que el modelo puede pedir. esquema es el JSON Schema de sus argumentos, como texto.
func conv_herramienta(c: Conversacion, nombre: String, descripcion: String, esquema: String)
    f = json_object()
    json_set_str(f, "name", nombre)
    json_set_str(f, "description", latin1_to_utf8(descripcion))
    p = json_parse(latin1_to_utf8(esquema))
    if p == nil
        p = json_object()
        json_set_str(p, "type", "object")
    end
    json_set(f, "parameters", p)
    h = json_object()
    json_set_str(h, "type", "function")
    json_set(h, "function", f)
    json_push(c.herramientas, h)
end

# Lo que escribe el usuario (en Latin-1)
func conv_usuario(c: Conversacion, texto: String)
    _conv_mensaje(c, "user", latin1_to_utf8(texto))
end

# El resultado de una herramienta (en Latin-1), para la llamada id
func conv_resultado(c: Conversacion, id: String, texto: String)
    m = json_object()
    json_set_str(m, "role", "tool")
    json_set_str(m, "tool_call_id", id)
    json_set_str(m, "content", latin1_to_utf8(texto))
    json_push(c.mensajes, m)
end

# Cuántos mensajes lleva (el de sistema incluido)
func conv_longitud(c: Conversacion) -> Int
    return json_length(c.mensajes)
end

func _conv_cuerpo(c: Conversacion, modelo: String) -> String
    p = json_object()
    json_set_str(p, "model", modelo)
    json_set(p, "messages", c.mensajes)
    # que OpenRouter diga lo que cuesta cada petición (usage.cost)
    u = json_object()
    json_set_bool(u, "include", true)
    json_set(p, "usage", u)
    if json_length(c.herramientas) > 0
        json_set(p, "tools", c.herramientas)
    end
    return json_write(p)
end

func _conv_cabeceras(cfg: Config) -> String
    cabeceras = "X-Title: Inferencia\r\nHTTP-Referer: https://github.com/FreeMEM/inferencia"
    if cfg.clave != ""
        cabeceras = "Authorization: Bearer " + cfg.clave + "\r\n" + cabeceras
    end
    return cabeceras
end

func _turno_error(e: String) -> Turno
    var ls: [Llamada] = []
    return Turno("", ls, "", "", 0, 0, e, 0)
end

# Manda la conversación sin esperar: http_avanzar(carga) hasta que dé true, y luego conv_acabar
func conv_empezar(c: Conversacion, cfg: Config) -> Carga
    return http_empezar_metodo(cfg.url, "POST", _conv_cuerpo(c, cfg.modelo), "application/json", _conv_cabeceras(cfg), ESPERA_PETICION)
end

# La respuesta de una carga ya acabada. Si fue bien, el mensaje del modelo se añade a la conversación.
func conv_acabar(c: Conversacion, carga: Carga) -> Turno
    return _conv_leer(c, carga.respuesta)
end

# Manda la conversación y espera la respuesta
func conv_pedir(c: Conversacion, cfg: Config) -> Turno
    r = http_pedir(cfg.url, "POST", _conv_cuerpo(c, cfg.modelo), "application/json", _conv_cabeceras(cfg), ESPERA_PETICION)
    return _conv_leer(c, r)
end

func _conv_leer(c: Conversacion, r: Respuesta) -> Turno
    if r.error != ""
        return _turno_error(r.error)
    end
    j = json_parse(r.cuerpo)
    if j == nil
        return _turno_error("HTTP #{r.estado}: la respuesta no es JSON (#{json_error()})")
    end
    if r.estado != 200 or json_has(j, "error")
        m = json_path_str(j, "error.message")
        if m == ""
            m = "sin explicación"
        end
        return _turno_error("HTTP #{r.estado}: " + utf8_to_latin1(m))
    end
    msj = json_path(j, "choices.0.message")
    if msj == nil
        return _turno_error("la respuesta no trae ningún mensaje")
    end
    # el mensaje vuelve tal cual a la conversación (con sus tool_calls), como pide la API
    json_push(c.mensajes, msj)

    var ls: [Llamada] = []
    lista = json_get(msj, "tool_calls")
    n = json_length(lista)
    i = 0
    while i < n
        tc = json_at(lista, i)
        i = i + 1
        crudo = json_path_str(tc, "function.arguments")
        a = json_parse(crudo)
        if a == nil
            a = json_object()
        end
        ls.push(Llamada(json_get_str(tc, "id"), json_path_str(tc, "function.name"), a, crudo))
    end
    t = Turno(utf8_to_latin1(json_get_str(msj, "content")), ls, json_path_str(j, "choices.0.finish_reason"), json_get_str(j, "model"), json_path_int(j, "usage.prompt_tokens"), json_path_int(j, "usage.completion_tokens"), "", _millonesimas(json_path(j, "usage.cost")))
    return t
end

# Un número de dólares ("0.00123", 1.5e-5) en millonésimas, sin pasar por Float
func _millonesimas(n: Json) -> Int
    if n == nil or n.kind != JSON_NUMBER
        return 0
    end
    t = str_lower(n.text)
    exp = 0
    e = str_find(t, "e")
    if e >= 0
        exp = Int(t[e + 1:])
        t = t[0:e]
    end
    # las cifras sin el punto, y dónde estaba
    p = str_find(t, ".")
    decimales = 0
    if p >= 0
        decimales = t.length - p - 1
        t = t[0:p] + t[p + 1:]
    end
    v = Int(t)
    # v * 10^(6 + exp - decimales)
    k = 6 + exp - decimales
    while k > 0
        v = v * 10
        k = k - 1
    end
    while k < 0
        v = v / 10
        k = k + 1
    end
    return v
end

# --- Memoria: lo que ocupa, recortar, resumir, guardar y cargar ---

# Lo que ocupa la conversación como se manda (caracteres)
func conv_tamano(c: Conversacion) -> Int
    return json_write(c.mensajes).length
end

# Quita el contenido de los resultados de herramientas viejos (todos menos los de los últimos "dejar" mensajes)
func conv_recortar(c: Conversacion, dejar: Int)
    n = json_length(c.mensajes)
    i = 1
    while i < n - dejar
        m = json_at(c.mensajes, i)
        if json_get_str(m, "role") == "tool" and json_get_str(m, "content").length > 200
            json_set_str(m, "content", "[resultado quitado para ahorrar memoria]")
        end
        i = i + 1
    end
end

# Una conversación aparte que pide al modelo un resumen de todo menos el último mensaje
func conv_para_resumen(c: Conversacion) -> Conversacion
    r = conv_nueva("Resume la conversación que te dan en pocos párrafos, en el idioma del usuario: lo que se pidió, lo que se hizo (ficheros leídos o cambiados, órdenes) y lo que quedó pendiente. Solo el resumen.")
    t = ""
    n = json_length(c.mensajes)
    i = 1
    while i < n - 1
        m = json_at(c.mensajes, i)
        rol = json_get_str(m, "role")
        contenido = json_get_str(m, "content")
        if rol == "tool" and contenido.length > 300
            contenido = contenido[0:300]
        end
        llamadas = json_get(m, "tool_calls")
        if llamadas != nil
            k = 0
            while k < json_length(llamadas)
                args = json_path_str(json_at(llamadas, k), "function.arguments")
                if args.length > 200
                    args = args[0:200]
                end
                contenido = contenido + " [pide " + json_path_str(json_at(llamadas, k), "function.name") + " " + args + "]"
                k = k + 1
            end
        end
        t = t + rol + ": " + contenido + "\n\n"
        i = i + 1
    end
    # (el texto ya va en UTF-8: directo a la API, sin conv_usuario)
    m = json_object()
    json_set_str(m, "role", "user")
    json_set_str(m, "content", t)
    json_push(r.mensajes, m)
    return r
end

# Cambia todo lo de antes del último mensaje por el resumen (en Latin-1)
func conv_resumir(c: Conversacion, resumen: String)
    n = json_length(c.mensajes)
    ultimo = json_at(c.mensajes, n - 1)
    nuevos = json_array()
    json_push(nuevos, json_at(c.mensajes, 0))
    m = json_object()
    json_set_str(m, "role", "user")
    json_set_str(m, "content", latin1_to_utf8("Resumen de la conversación hasta aquí:\n" + resumen))
    json_push(nuevos, m)
    a = json_object()
    json_set_str(a, "role", "assistant")
    json_set_str(a, "content", "De acuerdo.")
    json_push(nuevos, a)
    json_push(nuevos, ultimo)
    c.mensajes = nuevos
end

# La conversación como fichero JSON (UTF-8)
func conv_guardar(c: Conversacion, modelo: String) -> String
    d = json_object()
    json_set_int(d, "inferencia", 1)
    json_set_str(d, "modelo", latin1_to_utf8(modelo))
    json_set(d, "mensajes", c.mensajes)
    return json_pretty(d) + "\n"
end

# Una conversación guardada (nil si el fichero no lo es); las herramientas, las de c
func conv_cargar(texto: String, c: Conversacion) -> Conversacion
    d = json_parse(texto)
    if d == nil or json_get_int(d, "inferencia") != 1 or json_get(d, "mensajes") == nil
        return nil
    end
    return Conversacion(json_get(d, "mensajes"), c.herramientas)
end

# Un argumento de texto de una llamada, en Latin-1 ("" si no está)
func llamada_str(l: Llamada, nombre: String) -> String
    return utf8_to_latin1(json_get_str(l.argumentos, nombre))
end

func llamada_int(l: Llamada, nombre: String) -> Int
    return json_get_int(l.argumentos, nombre)
end

# --- Una pregunta suelta (la prueba F0) ---

struct Contestacion
    texto: String
    modelo: String
    error: String
end

func preguntar(url: String, clave: String, modelo: String, pregunta: String) -> Contestacion
    c = conv_nueva("")
    conv_usuario(c, pregunta)
    t = conv_pedir(c, Config(url, clave, modelo))
    return Contestacion(t.texto, t.modelo, t.error)
end
