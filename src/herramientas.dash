# Las herramientas que el modelo puede pedir: leer, listar, buscar, escribir, editar, orden, puertos, arexx, sistema,
# entorno y portapapeles.
#
#   herramientas_declarar(conv)                # una vez, al empezar la conversación
#   if herramienta_pide_permiso(l) ...         # escribir, editar, orden, arexx, poner en entorno y escribir en el
#                                              # portapapeles, salvo lo de ENV:Inferencia/sin_permiso
#   vista_anadir(QUIEN_HERRAMIENTA, herramienta_resumen(l))
#   resultado = herramienta_ejecutar(l)        # todas menos orden, que va con orden_empezar y orden_acabar
#
# Los resultados llevan topes de tamaño: lo que pasa del tope se corta y se dice. Si Forja tiene abierto el
# fichero (puerto FORJA.1), leer, escribir y editar usan lo que hay en su editor: los cambios quedan sin guardar
# y entran en su deshacer.

import "openrouter.dash"

const TOPE_LEER = 20000         # caracteres de un fichero
const TOPE_SALIDA = 8000        # caracteres de la salida de una orden
const TOPE_LISTAR = 300         # entradas de un cajón
const TOPE_BUSCAR = 100         # líneas encontradas
const TOPE_FICHEROS = 400       # ficheros mirados al buscar
const TOPE_TAMANO_BUSCAR = 200000
const TOPE_SEGUNDOS = 120       # una orden, como mucho
const PUERTO_PROPIO = "INFERENCIA.1"
const PUERTO_FORJA = "FORJA.1"

# Lo aceptado con "Siempre": nombres de herramienta ("escribir", "editar") y, para orden, la primera palabra
var permitidos: [String] = []

func herramientas_declarar(c: Conversacion)
    conv_herramienta(c, "leer", "Lee un fichero de texto. Con desde y hasta, solo esas líneas (desde 1).", "{\"type\":\"object\",\"properties\":{\"fichero\":{\"type\":\"string\",\"description\":\"Ruta de AmigaOS, como S:Startup-Sequence\"},\"desde\":{\"type\":\"integer\"},\"hasta\":{\"type\":\"integer\"}},\"required\":[\"fichero\"]}")
    conv_herramienta(c, "listar", "Lista lo que hay en un cajón (directorio): los cajones acaban en /, los ficheros llevan su tamaño.", "{\"type\":\"object\",\"properties\":{\"cajon\":{\"type\":\"string\",\"description\":\"Ruta de AmigaOS, como SYS: o Work:Proyectos\"}},\"required\":[\"cajon\"]}")
    conv_herramienta(c, "buscar", "Busca un texto (sin mirar mayúsculas) en los ficheros de un cajón y de los cajones de dentro. Da fichero, línea y texto de cada línea que lo tiene.", "{\"type\":\"object\",\"properties\":{\"cajon\":{\"type\":\"string\"},\"texto\":{\"type\":\"string\"}},\"required\":[\"cajon\",\"texto\"]}")
    conv_herramienta(c, "escribir", "Crea un fichero o lo sustituye entero por el contenido. El usuario tiene que permitirlo.", "{\"type\":\"object\",\"properties\":{\"fichero\":{\"type\":\"string\"},\"contenido\":{\"type\":\"string\"}},\"required\":[\"fichero\",\"contenido\"]}")
    conv_herramienta(c, "editar", "Cambia en un fichero un trozo exacto de texto por otro. El trozo tiene que estar una sola vez; si no, da error. El usuario tiene que permitirlo.", "{\"type\":\"object\",\"properties\":{\"fichero\":{\"type\":\"string\"},\"buscar\":{\"type\":\"string\",\"description\":\"El texto que hay ahora, exacto\"},\"cambiar\":{\"type\":\"string\",\"description\":\"El texto nuevo\"}},\"required\":[\"fichero\",\"buscar\",\"cambiar\"]}")
    conv_herramienta(c, "puertos", "Lista los puertos ARexx y públicos abiertos: con ellos se sabe a qué programas se les puede mandar órdenes con la herramienta arexx.", "{\"type\":\"object\",\"properties\":{}}")
    conv_herramienta(c, "arexx", "Manda una orden ARexx al puerto de un programa (como MULTIVIEW.1 o FORJA) y devuelve su resultado y su código. El usuario tiene que permitirlo.", "{\"type\":\"object\",\"properties\":{\"puerto\":{\"type\":\"string\"},\"orden\":{\"type\":\"string\",\"description\":\"La orden con sus argumentos, como la escribiría un script\"}},\"required\":[\"puerto\",\"orden\"]}")
    conv_herramienta(c, "sistema", "Mira el sistema: memoria libre, versión de AmigaOS, procesador y MUI; volúmenes con su espacio; asignaciones; tareas en marcha.", "{\"type\":\"object\",\"properties\":{\"que\":{\"type\":\"string\",\"enum\":[\"resumen\",\"volumenes\",\"asignaciones\",\"tareas\"],\"description\":\"resumen si no se da\"}}}")
    conv_herramienta(c, "entorno", "Variables de entorno de ENV: (las de AmigaOS): leer una, listarlas o poner una (poner pide permiso; guardar=true la deja también en ENVARC:).", "{\"type\":\"object\",\"properties\":{\"accion\":{\"type\":\"string\",\"enum\":[\"leer\",\"listar\",\"poner\"]},\"nombre\":{\"type\":\"string\"},\"valor\":{\"type\":\"string\"},\"guardar\":{\"type\":\"boolean\"}},\"required\":[\"accion\"]}")
    conv_herramienta(c, "portapapeles", "Lee el texto del portapapeles o escribe uno (escribir pide permiso).", "{\"type\":\"object\",\"properties\":{\"accion\":{\"type\":\"string\",\"enum\":[\"leer\",\"escribir\"]},\"texto\":{\"type\":\"string\"}},\"required\":[\"accion\"]}")
    conv_herramienta(c, "orden", "Ejecuta una línea del Shell de AmigaOS y devuelve lo que escribe y su código de retorno. El usuario tiene que permitirlo.", "{\"type\":\"object\",\"properties\":{\"orden\":{\"type\":\"string\",\"description\":\"Como se escribe en el Shell, como List SYS: o Version\"},\"segundos\":{\"type\":\"integer\",\"description\":\"Tiempo máximo (60 si no se da)\"}},\"required\":[\"orden\"]}")
end

func _primera_palabra(s: String) -> String
    p = str_split(str_trim(s), " ")
    return str_lower(p[0])
end

func _clave_permiso(l: Llamada) -> String
    if l.nombre == "orden"
        return "orden " + _primera_palabra(llamada_str(l, "orden"))
    end
    if l.nombre == "arexx"
        return "arexx " + str_upper(llamada_str(l, "puerto"))
    end
    return l.nombre
end

func herramienta_pide_permiso(l: Llamada) -> Bool
    if l.nombre == "entorno"
        if llamada_str(l, "accion") != "poner"
            return false
        end
    elif l.nombre == "portapapeles"
        if llamada_str(l, "accion") != "escribir"
            return false
        end
    elif l.nombre != "escribir" and l.nombre != "editar" and l.nombre != "orden" and l.nombre != "arexx"
        return false
    end
    clave = _clave_permiso(l)
    for p in permitidos
        if p == clave
            return false
        end
    end
    return true
end

# "Siempre": lo mismo ya no pregunta, tampoco tras reiniciar (ENVARC:Inferencia/sin_permiso)
func herramienta_permitir_siempre(l: Llamada)
    permitidos.push(_clave_permiso(l))
    t = ""
    for p in permitidos
        if t != ""
            t = t + ","
        end
        t = t + p
    end
    env_set("Inferencia/sin_permiso", t, true)
end

# La lista de lo que no pide permiso: ENV:Inferencia/sin_permiso, separado por comas: "orden list,arexx FORJA.1,
# entorno,portapapeles,escribir,editar" (una orden por su primera palabra, un puerto por su nombre)
func permisos_leer()
    permitidos = []
    for p in str_split(env_get("Inferencia/sin_permiso"), ",")
        p = str_trim(p)
        if p != ""
            partes = str_split(p, " ")
            if partes[0] == "arexx" and partes.length > 1
                permitidos.push("arexx " + str_upper(partes[1]))
            elif partes[0] == "orden" and partes.length > 1
                permitidos.push("orden " + str_lower(partes[1]))
            else
                permitidos.push(str_lower(p))
            end
        end
    end
end

# Lo que se ve en la conversación antes de ejecutarla (con el cambio entero, si cambia algo)
func herramienta_resumen(l: Llamada) -> String
    if l.nombre == "leer"
        return tr(40, "Leer ") + llamada_str(l, "fichero")
    elif l.nombre == "listar"
        return tr(41, "Listar ") + llamada_str(l, "cajon")
    elif l.nombre == "buscar"
        return hueco2(tr(42, "Buscar \"%1\" en %2"), llamada_str(l, "texto"), llamada_str(l, "cajon"))
    elif l.nombre == "orden"
        return tr(43, "Orden: ") + llamada_str(l, "orden")
    elif l.nombre == "sistema"
        q = llamada_str(l, "que")
        if q == ""
            q = tr(25, "resumen")
        end
        return tr(26, "Sistema: ") + q
    elif l.nombre == "entorno"
        a = llamada_str(l, "accion")
        if a == "poner"
            r = tr(44, "Poner ENV:") + llamada_str(l, "nombre") + " = " + llamada_str(l, "valor")
            if json_get_bool(l.argumentos, "guardar")
                r = r + tr(27, " (también en ENVARC:)")
            end
            return r
        end
        if a == "listar"
            return tr(28, "Listar ENV:")
        end
        return tr(45, "Leer ENV:") + llamada_str(l, "nombre")
    elif l.nombre == "portapapeles"
        if llamada_str(l, "accion") == "escribir"
            return tr(46, "Escribir en el portapapeles") + _marcar(llamada_str(l, "texto"), "+ ", 12)
        end
        return tr(29, "Leer el portapapeles")
    elif l.nombre == "puertos"
        return tr(30, "Puertos ARexx")
    elif l.nombre == "arexx"
        return hueco2(tr(47, "ARexx a %1: %2"), llamada_str(l, "puerto"), llamada_str(l, "orden"))
    elif l.nombre == "escribir"
        contenido = llamada_str(l, "contenido")
        r = hueco2(tr(48, "Escribir %1 (%2 caracteres)"), llamada_str(l, "fichero"), "#{contenido.length}")
        return r + _marcar(contenido, "+ ", 12)
    elif l.nombre == "editar"
        r = tr(49, "Editar ") + llamada_str(l, "fichero")
        return r + _marcar(llamada_str(l, "buscar"), "- ", 20) + _marcar(llamada_str(l, "cambiar"), "+ ", 20)
    end
    return tr(31, "Herramienta desconocida: ") + l.nombre
end

# Las líneas de un texto, cada una con su marca delante, hasta n
func _marcar(texto: String, marca: String, n: Int) -> String
    r = ""
    lineas = str_split(texto, "\n")
    i = 0
    for linea in lineas
        if i == n
            r = r + "\n" + marca + hueco(tr(50, "(%1 líneas más)"), "#{lineas.length - n}")
            break
        end
        r = r + "\n" + marca + linea
        i = i + 1
    end
    return r
end

func _cortar(texto: String, tope: Int) -> String
    if texto.length <= tope
        return texto
    end
    return texto[0:tope] + "\n[cortado: el texto tenía #{texto.length} caracteres]"
end

func ruta_unir(cajon: String, nombre: String) -> String
    if cajon == "" or str_ends(cajon, ":") or str_ends(cajon, "/")
        return cajon + nombre
    end
    return cajon + "/" + nombre
end

# --- Forja: si tiene el fichero abierto, se lee y se cambia allí (los cambios entran en su deshacer) ---

func forja_abierto(fichero: String) -> Bool
    r = rexx_send(PUERTO_FORJA, "ABIERTO \"" + fichero + "\"")
    return rexx_rc() == 0 and r == "1"
end

func _contar(s: String, sub: String) -> Int
    n = 0
    p = str_find(s, sub)
    while p >= 0
        n = n + 1
        p = str_find_from(s, sub, p + sub.length)
    end
    return n
end

# El texto de un fichero: el de Forja si lo tiene abierto, si no el del disco (nil si no se puede leer)
func texto_de(fichero: String) -> String
    if forja_abierto(fichero)
        t = rexx_send(PUERTO_FORJA, "TEXTO \"" + fichero + "\"")
        if rexx_rc() == 0
            return t
        end
    end
    return file_read_text(fichero)
end

func _forja_cambiar(fichero: String, desde: Int, hasta: Int, texto: String) -> Bool
    rexx_send(PUERTO_FORJA, "CAMBIAR \"" + fichero + "\" #{desde} #{hasta} \"" + texto + "\"")
    return rexx_rc() == 0
end

func _leer(l: Llamada) -> String
    fichero = llamada_str(l, "fichero")
    texto = texto_de(fichero)
    if texto == nil
        return "Error: no se puede leer " + fichero
    end
    desde = llamada_int(l, "desde")
    hasta = llamada_int(l, "hasta")
    if desde > 0 or hasta > 0
        lineas = str_split(texto, "\n")
        if desde < 1
            desde = 1
        end
        if hasta < 1 or hasta > lineas.length
            hasta = lineas.length
        end
        r = ""
        i = desde
        while i <= hasta
            r = r + lineas[i - 1] + "\n"
            i = i + 1
        end
        texto = r
    end
    return _cortar(texto, TOPE_LEER)
end

func _listar(l: Llamada) -> String
    cajon = llamada_str(l, "cajon")
    n = dir_read(cajon)
    if n < 0
        return "Error: no se puede leer el cajón " + cajon
    end
    if n == 0
        return "(vacío)"
    end
    r = ""
    i = 0
    while i < n and i < TOPE_LISTAR
        if dir_entry_is_dir(i)
            r = r + dir_entry_name(i) + "/\n"
        else
            r = r + dir_entry_name(i) + "  #{dir_entry_size(i)}\n"
        end
        i = i + 1
    end
    if n > TOPE_LISTAR
        r = r + "[y #{n - TOPE_LISTAR} más]\n"
    end
    return r
end

var _buscar_hallados: Int = 0
var _buscar_mirados: Int = 0

func _buscar_en(cajon: String, texto: String, nivel: Int) -> String
    n = dir_read(cajon)
    if n < 0
        return ""
    end
    # dir_read se pisa al entrar en otro cajón: primero se apunta lo de este
    var ficheros: [String] = []
    var cajones: [String] = []
    i = 0
    while i < n
        if dir_entry_is_dir(i)
            cajones.push(ruta_unir(cajon, dir_entry_name(i)))
        elif dir_entry_size(i) <= TOPE_TAMANO_BUSCAR
            ficheros.push(ruta_unir(cajon, dir_entry_name(i)))
        end
        i = i + 1
    end
    r = ""
    for f in ficheros
        if _buscar_hallados >= TOPE_BUSCAR or _buscar_mirados >= TOPE_FICHEROS
            return r
        end
        _buscar_mirados = _buscar_mirados + 1
        contenido = file_read_text(f)
        if contenido != nil and str_contains(str_lower(contenido), texto)
            num = 1
            for linea in str_split(contenido, "\n")
                if str_contains(str_lower(linea), texto) and _buscar_hallados < TOPE_BUSCAR
                    r = r + f + ":#{num}: " + str_trim(linea) + "\n"
                    _buscar_hallados = _buscar_hallados + 1
                end
                num = num + 1
            end
        end
    end
    if nivel < 6
        for c in cajones
            r = r + _buscar_en(c, texto, nivel + 1)
        end
    end
    return r
end

func _buscar(l: Llamada) -> String
    texto = str_lower(llamada_str(l, "texto"))
    if texto == ""
        return "Error: falta el texto que buscar"
    end
    _buscar_hallados = 0
    _buscar_mirados = 0
    r = _buscar_en(llamada_str(l, "cajon"), texto, 0)
    if r == ""
        r = "No está en ningún fichero (mirados: #{_buscar_mirados})."
    elif _buscar_hallados >= TOPE_BUSCAR or _buscar_mirados >= TOPE_FICHEROS
        r = r + "[parado en el tope: #{TOPE_BUSCAR} líneas o #{TOPE_FICHEROS} ficheros]\n"
    end
    return _cortar(r, TOPE_LEER)
end

func _escribir(l: Llamada) -> String
    fichero = llamada_str(l, "fichero")
    contenido = llamada_str(l, "contenido")
    if forja_abierto(fichero)
        n = _contar(texto_de(fichero), "\n") + 1
        if _forja_cambiar(fichero, 1, n, contenido)
            return "Escrito en Forja, sin guardar: " + fichero + " (#{contenido.length} caracteres)"
        end
    end
    if file_write_text(fichero, contenido)
        return "Escrito: " + fichero + " (#{contenido.length} caracteres)"
    end
    return "Error: no se puede escribir " + fichero
end

func _editar(l: Llamada) -> String
    fichero = llamada_str(l, "fichero")
    buscar = llamada_str(l, "buscar")
    cambiar = llamada_str(l, "cambiar")
    en_forja = forja_abierto(fichero)
    texto = texto_de(fichero)
    if texto == nil
        return "Error: no se puede leer " + fichero
    end
    if buscar == ""
        return "Error: el trozo que buscar está vacío"
    end
    p = str_find(texto, buscar)
    if p < 0
        return "Error: el trozo no está en " + fichero + ". Léelo otra vez y copia el trozo exacto."
    end
    if str_find_from(texto, buscar, p + 1) >= 0
        return "Error: el trozo está más de una vez en " + fichero + ". Da un trozo más largo."
    end
    if en_forja
        # las líneas enteras donde está el trozo, cambiadas en Forja
        desde = _contar(texto[0:p], "\n") + 1
        hasta = desde + _contar(buscar, "\n")
        ini = p
        while ini > 0 and texto[ini - 1:ini] != "\n"
            ini = ini - 1
        end
        fin = str_find_from(texto, "\n", p + buscar.length)
        if fin < 0
            fin = texto.length
        end
        if _forja_cambiar(fichero, desde, hasta, texto[ini:p] + cambiar + texto[p + buscar.length:fin])
            return "Cambiado en Forja, sin guardar: " + fichero
        end
        return "Error: Forja no aceptó el cambio en " + fichero
    end
    nuevo = texto[0:p] + cambiar + texto[p + buscar.length:]
    if not file_write_text(fichero, nuevo)
        return "Error: no se puede escribir " + fichero
    end
    return "Cambiado: " + fichero
end

func _version_os() -> String
    v = library_version("exec.library")
    if v >= 47
        return "AmigaOS 3.2"
    elif v == 46
        return "AmigaOS 3.1.4"
    elif v == 45
        return "AmigaOS 3.9"
    elif v == 44
        return "AmigaOS 3.5"
    elif v >= 40
        return "AmigaOS 3.1"
    elif v >= 39
        return "AmigaOS 3.0"
    end
    return "AmigaOS (exec #{v})"
end

func _kb(bytes: Int) -> String
    return "#{bytes / 1024} KB"
end

func _sistema(l: Llamada) -> String
    q = llamada_str(l, "que")
    r = ""
    if q == "" or q == "resumen"
        r = _version_os() + " (exec.library #{library_version("exec.library")}), procesador #{cpu_model()}\n"
        mui = library_version("muimaster.library")
        if mui > 0
            r = r + "MUI: muimaster.library #{mui}\n"
        end
        r = r + "Memoria libre: chip " + _kb(mem_chip_free()) + " de " + _kb(mem_chip_total()) + ", fast " + _kb(mem_fast_free()) + " de " + _kb(mem_fast_total()) + "; el bloque más grande, " + _kb(mem_largest()) + "\n"
    elif q == "volumenes"
        n = disks_read(2000)
        i = 0
        while i < n
            if disk_kb(i) < 0
                r = r + disk_name(i) + ": (no contestó)\n"
            else
                r = r + disk_name(i) + ": #{disk_free_kb(i)} KB libres de #{disk_kb(i)} KB\n"
            end
            i = i + 1
        end
    elif q == "asignaciones"
        n = assigns_read()
        i = 0
        while i < n
            r = r + assign_name(i) + ": " + assign_path(i) + "\n"
            i = i + 1
        end
    elif q == "tareas"
        n = tasks_read()
        i = 0
        while i < n
            t = task_entry_name(i)
            if task_entry_command(i) != ""
                t = t + " (" + task_entry_command(i) + ")"
            end
            r = r + t + ", #{task_entry_state(i)}, prioridad #{task_entry_priority(i)}\n"
            i = i + 1
        end
    else
        return "Error: que es resumen, volumenes, asignaciones o tareas"
    end
    return _cortar(r, TOPE_LEER)
end

func _entorno(l: Llamada) -> String
    a = llamada_str(l, "accion")
    nombre = llamada_str(l, "nombre")
    if a == "listar"
        n = dir_read("ENV:")
        r = ""
        i = 0
        while i < n and i < TOPE_LISTAR
            if dir_entry_is_dir(i)
                r = r + dir_entry_name(i) + "/\n"
            else
                r = r + dir_entry_name(i) + "\n"
            end
            i = i + 1
        end
        return r
    end
    if nombre == ""
        return "Error: falta el nombre de la variable"
    end
    if a == "leer"
        v = env_get(nombre)
        if v == ""
            return "(no existe o está vacía)"
        end
        return v
    elif a == "poner"
        if env_set(nombre, llamada_str(l, "valor"), json_get_bool(l.argumentos, "guardar"))
            return "Puesta: " + nombre
        end
        return "Error: no se pudo poner " + nombre
    end
    return "Error: accion es leer, listar o poner"
end

func _portapapeles(l: Llamada) -> String
    if llamada_str(l, "accion") == "escribir"
        if clip_write_text(latin1_to_utf8(llamada_str(l, "texto")))
            return "Copiado al portapapeles"
        end
        return "Error: no se pudo escribir en el portapapeles"
    end
    t = utf8_to_latin1(clip_read_text())
    if t == ""
        return "(el portapapeles está vacío o no tiene texto)"
    end
    return _cortar(t, TOPE_LEER)
end

func _puertos() -> String
    n = ports_read()
    r = ""
    i = 0
    while i < n
        r = r + port_name(i) + "\n"
        i = i + 1
    end
    if r == ""
        return "(ninguno)"
    end
    return r
end

func _arexx(l: Llamada) -> String
    puerto = llamada_str(l, "puerto")
    if str_upper(puerto) == PUERTO_PROPIO
        return "Error: ese es el puerto de Inferencia; no se puede mandar órdenes a sí misma."
    end
    r = rexx_send(puerto, llamada_str(l, "orden"))
    rc = rexx_rc()
    if rc == -1
        return "Error: no hay ningún puerto que se llame " + puerto + ". La herramienta puertos dice cuáles hay."
    end
    if rc == -2
        return "Error: no está rexxsyslib.library."
    end
    return _cortar(r, TOPE_SALIDA) + "\n[RC: #{rc}]"
end

# Todas menos orden (que no debe parar la ventana: orden_empezar)
func herramienta_ejecutar(l: Llamada) -> String
    if l.nombre == "leer"
        return _leer(l)
    elif l.nombre == "listar"
        return _listar(l)
    elif l.nombre == "buscar"
        return _buscar(l)
    elif l.nombre == "escribir"
        return _escribir(l)
    elif l.nombre == "editar"
        return _editar(l)
    elif l.nombre == "puertos"
        return _puertos()
    elif l.nombre == "sistema"
        return _sistema(l)
    elif l.nombre == "entorno"
        return _entorno(l)
    elif l.nombre == "portapapeles"
        return _portapapeles(l)
    elif l.nombre == "arexx"
        return _arexx(l)
    end
    return "Error: no hay ninguna herramienta que se llame " + l.nombre
end

# La orden sin esperar: run_ready(n) hasta que acabe y orden_acabar(n). 0 si no pudo empezar.
func orden_empezar(l: Llamada) -> Int
    segundos = llamada_int(l, "segundos")
    if segundos <= 0
        segundos = 60
    end
    if segundos > TOPE_SEGUNDOS
        segundos = TOPE_SEGUNDOS
    end
    return run_start(llamada_str(l, "orden"), segundos * 1000)
end

func orden_acabar(n: Int) -> String
    salida = run_finish(n)
    rc = run_rc()
    r = _cortar(salida, TOPE_SALIDA)
    if rc == -2
        return r + "\n[se acabó el tiempo y se paró con Ctrl-C]"
    end
    return r + "\n[código de retorno: #{rc}]"
end
