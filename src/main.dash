# Inferencia: la IA en el Amiga.
#
# La ventana (ventana.dashui): el modelo arriba, la conversación en el medio y la línea para escribir abajo.
# La petición avanza sin bloquear la ventana; "Parar" la corta.
#
# Cuando el modelo pide herramientas, se ejecutan una a una y sus resultados vuelven al modelo, hasta que
# contesta sin pedir más. Las que cambian algo (escribir, editar, orden) preguntan antes con botones dentro de
# la conversación: Sí, No y Siempre.
#
# Puerto ARexx INFERENCIA.1: PREGUNTA "texto" la manda (sin esperar: RC 5 si está ocupada); ESTADO dice libre,
# pidiendo, permiso u orden; RESPUESTA da la última respuesta cuando está libre (RC 5 si no, 10 si hubo un
# error); CONTEXTO fichero [desde hasta] lo añade a la siguiente pregunta, y ADJUNTAR título (con el texto en las
# líneas siguientes) también; NUEVA, MOSTRAR y OCULTAR; GUARDAR fichero y CARGAR fichero (la conversación, en JSON);
# COSTE ("tokens_de_entrada tokens_de_salida millonésimas_de_dólar"); MENSAJES (cuántos lleva).
#
# Preferencias (Amiga-P): proveedor, dirección, clave, modelo y tope; Usar las deja hasta reiniciar, Guardar también
# en ENVARC:.
#
# Con el formato de OpenAI, la respuesta se pide según llega ("stream": true, eventos SSE) y se va enseñando;
# ENV:Inferencia/flujo = no lo quita.
#
# La conversación se reenvía entera en cada petición. Si pasa de ENV:Inferencia/tope caracteres (60000), se quitan
# los resultados viejos de las herramientas y, si aún pasa, se pide al modelo un resumen de lo anterior.
#
# Para las pruebas: ENV:INFERENCIA_PRUEBA con un texto lo manda al abrir, y el programa se cierra solo unos
# segundos después de la respuesta. "@fichero" toma el texto de ese fichero. ENV:INFERENCIA_PRUEBA_LINEA lleva la
# vista a esa línea después de la respuesta. ENV:INFERENCIA_PRUEBA_PERMISO (Si, No o Siempre) contesta solo a los
# permisos, tres segundos después de preguntar.
#
# Con ENV:INFERENCIA_SONDA, para un programa que hace de usuario (tests/clics.dash): ENV:INFERENCIA_ESTADO dice
# qué hace (libre, pidiendo, "permiso N" con N la vez que pregunta, orden) y ENV:INFERENCIA_BOTONES dónde están los botones ("x,y x,y...",
# desde la esquina de la ventana).

@catalog "Inferencia.catalog" 1 "español"

import "config.dash"
import "openrouter.dash"
import "herramientas.dash"
import "vista.dash"
import "ventana.dashui"

const SISTEMA = "Eres Inferencia, un asistente que funciona en un Amiga con AmigaOS 3. Contesta en el idioma del usuario, con frases cortas. Tienes herramientas para leer, buscar y cambiar ficheros y para ejecutar órdenes del Shell; úsalas cuando hagan falta. Las rutas son de AmigaOS (SYS:, S:, Work:Cajón/fichero). Un guion ARexx empieza siempre con un comentario /* ... */ en la primera línea: sin él, rx dice Program not found."

const EV_ENVIAR = 1
const EV_PARAR = 2
const EV_BARRA = 3
const EV_LIENZO = 4
const EV_TIC = 5
const EV_NUEVA = 20
const EV_GUARDAR = 21
const EV_ABRIR = 22
const EV_PREFERENCIAS = 23
const EV_PREF_GUARDAR = 40
const EV_PREF_USAR = 41
const EV_PREF_CANCELAR = 42
const EV_PREF_PROVEEDOR = 43
const TOPE_CONVERSACION = 60000   # caracteres; ENV:Inferencia/tope lo cambia
const EV_SALIR = 99
const TIC_MS = 50            # mientras pasa algo
const TIC_QUIETO_MS = 300    # si no: para seguir a la vista cuando la ventana cambia de tamaño
const CIERRE_PRUEBA_TICS = 50
const PERMISO_PRUEBA_TICS = 60
const MAX_VUELTAS = 25       # peticiones seguidas con herramientas antes de parar
const LINEAS_SALIDA = 12     # de la salida de una orden, las que se ven
const NO_PERMITIDO = "El usuario no lo ha permitido."

const LIBRE = 0
const PIDIENDO = 1
const PERMISO = 2
const ORDEN = 3

var v: Principal = nil
var pref: Preferencias = nil
var app: Int = 0
var ultima_respuesta: String = ""
var ultimo_error: String = ""
var contexto: String = ""       # lo que CONTEXTO añade a la siguiente pregunta
var cfg: Config = nil
var conv: Conversacion = nil
var carga: Carga = nil
var estado: Int = LIBRE
var pendientes: [Llamada] = []
var indice: Int = 0
var vueltas: Int = 0
var orden_en_marcha: Int = 0
var prueba: Bool = false
var prueba_permiso: String = ""
var tics_permiso: Int = -1
var tokens_entrada: Int = 0
var tokens_salida: Int = 0
var coste: Int = 0                  # millonésimas de dólar
var resumiendo: Conversacion = nil  # la petición del resumen, mientras se hace
var flujo: Flujo = nil              # la respuesta según llega
var parcial: Bool = false           # el último bloque de la vista es la respuesta que va llegando
var parcial_ms: Int = 0             # cuándo se enseñó por última vez
const PARCIAL_MS = 250
var barra_valor: Int = -1
var tics_cierre: Int = -1
var sonda: Bool = false
var sonda_estado: String = ""
var sonda_botones: String = "-"
var permisos_pedidos: Int = 0

func publicar_sonda()
    var nombres: [String] = ["libre", "pidiendo", "permiso", "orden"]
    e = nombres[estado]
    if estado == PERMISO
        e = e + " #{permisos_pedidos}"
    end
    b = vista_botones_ventana()
    # los botones, antes que el estado: quien espera "permiso" ya los encuentra
    if b != sonda_botones
        sonda_botones = b
        env_set("INFERENCIA_BOTONES", b, false)
    end
    if e != sonda_estado
        sonda_estado = e
        env_set("INFERENCIA_ESTADO", e, false)
    end
end

func dibujar(x: Int, y: Int, ancho: Int, alto: Int)
    vista_dibujar(x, y, ancho, alto)
end

# La barra sigue a la vista (cuando el texto o el alto cambian, y cuando la vista baja sola al final)
func ajustar_barra()
    if vista_cambio_rango()
        mui_set_range(v.barra, vista_total(), vista_visibles())
        barra_valor = -1
    end
    if vista_primera != barra_valor
        barra_valor = vista_primera
        mui_set_value(v.barra, vista_primera)
    end
end

func refrescar()
    mui_canvas_redraw(v.conversacion)
    ajustar_barra()
end

func poner_estado(e: Int)
    estado = e
    ocupado = e != LIBRE
    mui_set_enabled(v.parar, ocupado)
    mui_set_enabled(v.enviar, not ocupado)
    if e == PIDIENDO
        mui_set_text(v.estado, tr(1, "Pensando..."))
    elif e == PERMISO
        mui_set_text(v.estado, tr(2, "¿Lo permites?"))
    elif e == ORDEN
        mui_set_text(v.estado, tr(3, "Orden en marcha"))
    else
        t = hueco(tr(51, "%1 tokens"), "#{tokens_entrada + tokens_salida}")
        if coste > 0
            # en dólares con cuatro decimales; corto, para que quepa al lado del modelo
            c = coste / 100
            cent = "" + (c % 10000 + 10000)
            t = hueco2(tr(52, "%1 tk · %2 $"), "#{tokens_entrada + tokens_salida}", "#{c / 10000}," + cent[1:])
        end
        mui_set_text(v.estado, t)
        if prueba
            tics_cierre = CIERRE_PRUEBA_TICS
        end
    end
end

func enviar(texto: String)
    if texto == "" or estado != LIBRE
        return
    end
    cfg.modelo = str_trim(mui_get_text(v.modelo))
    vista_anadir(QUIEN_USUARIO, texto)
    conv_usuario(conv, contexto + texto)
    contexto = ""
    ultima_respuesta = ""
    ultimo_error = ""
    vueltas = 0
    if not resumir_si_hace_falta()
        pedir()
    end
end

func pedir()
    flujo = flujo_nuevo()
    parcial = false
    carga = conv_empezar(conv, cfg)
    poner_estado(PIDIENDO)
    refrescar()
end

func tope() -> Int
    t = env_get("Inferencia/tope")
    if t == ""
        return TOPE_CONVERSACION
    end
    return Int(t)
end

# Si la conversación pasa del tope: primero se quitan los resultados viejos de las herramientas; si aún pasa, se
# pide al modelo un resumen de todo lo anterior a la pregunta nueva (true: la petición del resumen ya va)
func resumir_si_hace_falta() -> Bool
    if conv_tamano(conv) <= tope()
        return false
    end
    conv_recortar(conv, 6)
    if conv_tamano(conv) <= tope() or conv_longitud(conv) < 4
        return false
    end
    vista_anadir(QUIEN_AVISO, tr(4, "La conversación es larga: pido un resumen de lo anterior."))
    resumiendo = conv_para_resumen(conv)
    flujo = flujo_nuevo()
    parcial = false
    carga = conv_empezar(resumiendo, cfg)
    poner_estado(PIDIENDO)
    refrescar()
    return true
end

func al_resumir()
    t = conv_acabar(resumiendo, carga, cfg, flujo)
    carga = nil
    resumiendo = nil
    tokens_entrada = tokens_entrada + t.entrada
    tokens_salida = tokens_salida + t.salida
    coste = coste + t.coste
    if t.error != "" or t.texto == ""
        vista_anadir(QUIEN_AVISO, tr(5, "No se pudo resumir (") + t.error + tr(6, "); sigue entera."))
    else
        conv_resumir(conv, t.texto)
        vista_anadir(QUIEN_AVISO, tr(7, "Resumida. Lo de antes va como resumen."))
    end
    pedir()
end

# La respuesta que va llegando, en la conversación (no la de un resumen; como mucho cada PARCIAL_MS)
func mostrar_parcial()
    if resumiendo != nil or flujo.texto == "" or time_ms() - parcial_ms < PARCIAL_MS
        return
    end
    parcial_ms = time_ms()
    if parcial
        vista_cambiar_ultimo(QUIEN_MODELO, flujo_texto(flujo))
    else
        vista_anadir(QUIEN_MODELO, flujo_texto(flujo))
        parcial = true
    end
    mui_set_text(v.estado, tr(8, "Escribiendo..."))
    refrescar()
end

# Ha llegado la respuesta del modelo
func al_llegar()
    if resumiendo != nil
        al_resumir()
        return
    end
    t = conv_acabar(conv, carga, cfg, flujo)
    carga = nil
    if t.error != ""
        parcial = false
        vista_anadir(QUIEN_AVISO, tr(9, "Error: ") + t.error)
        ultimo_error = t.error
        poner_estado(LIBRE)
        refrescar()
        return
    end
    tokens_entrada = tokens_entrada + t.entrada
    tokens_salida = tokens_salida + t.salida
    coste = coste + t.coste
    if t.texto != ""
        if parcial
            vista_cambiar_ultimo(QUIEN_MODELO, t.texto)
        else
            vista_anadir(QUIEN_MODELO, t.texto)
        end
    end
    parcial = false
    if t.llamadas.length == 0
        ultima_respuesta = t.texto
        if t.fin == "length"
            vista_anadir(QUIEN_AVISO, tr(10, "La respuesta se cortó: el modelo llegó a su tope de longitud."))
        end
        poner_estado(LIBRE)
        refrescar()
        return
    end
    pendientes = t.llamadas
    indice = 0
    vueltas = vueltas + 1
    if vueltas > MAX_VUELTAS
        vista_anadir(QUIEN_AVISO, hueco(tr(53, "Parado: el modelo lleva %1 vueltas seguidas con herramientas."), "#{MAX_VUELTAS}"))
        cerrar_pendientes("No se ejecutó: demasiadas vueltas seguidas.")
        poner_estado(LIBRE)
        refrescar()
        return
    end
    seguir()
end

# Las herramientas pendientes, una a una; al acabar, sus resultados van al modelo
func seguir()
    while indice < pendientes.length
        l = pendientes[indice]
        vista_anadir(QUIEN_HERRAMIENTA, herramienta_resumen(l))
        if herramienta_pide_permiso(l)
            var botones: [String] = [tr(54, "Sí"), tr(55, "No"), tr(56, "Siempre")]
            vista_botones(botones)
            permisos_pedidos = permisos_pedidos + 1
            poner_estado(PERMISO)
            tics_permiso = PERMISO_PRUEBA_TICS
            refrescar()
            return
        end
        if not ejecutar(l)
            return
        end
    end
    pedir()
end

# false si se quedó en marcha (una orden)
func ejecutar(l: Llamada) -> Bool
    if l.nombre == "orden"
        orden_en_marcha = orden_empezar(l)
        if orden_en_marcha == 0
            resultado("Error: no se pudo empezar la orden.")
            return true
        end
        poner_estado(ORDEN)
        refrescar()
        return false
    end
    resultado(herramienta_ejecutar(l))
    return true
end

# El resultado de la herramienta actual: al modelo, y a la vista lo que interesa al usuario
func resultado(r: String)
    l = pendientes[indice]
    indice = indice + 1
    conv_resultado(conv, l.id, r)
    if str_starts(r, "Error")
        vista_anadir(QUIEN_AVISO, r)
    elif l.nombre == "orden" and r != NO_PERMITIDO
        lineas = str_split(str_trim(r), "\n")
        s = tr(12, "Salida")
        i = 0
        for linea in lineas
            if i == LINEAS_SALIDA and lineas.length > LINEAS_SALIDA + 1
                s = s + "\n" + hueco(tr(50, "(%1 líneas más)"), "#{lineas.length - i}")
                break
            end
            s = s + "\n" + linea
            i = i + 1
        end
        vista_anadir(QUIEN_HERRAMIENTA, s)
    end
    refrescar()
end

# Las que quedan sin hacer también llevan resultado, porque la API lo pide para cada llamada
func cerrar_pendientes(motivo: String)
    while indice < pendientes.length
        conv_resultado(conv, pendientes[indice].id, motivo)
        indice = indice + 1
    end
end

func responder_permiso(n: Int)
    if estado != PERMISO or n < 0
        return
    end
    l = pendientes[indice]
    if n == 1
        vista_responder(tr(55, "No"))
        resultado(NO_PERMITIDO)
        seguir()
        return
    end
    if n == 2
        herramienta_permitir_siempre(l)
        vista_responder(tr(56, "Siempre"))
    else
        vista_responder(tr(54, "Sí"))
    end
    poner_estado(PIDIENDO)
    if ejecutar(l)
        seguir()
    end
end

# Sigue lo que esté en marcha
func avanzar()
    if estado == PIDIENDO
        if carga == nil
            return
        end
        if http_avanzar(carga)
            al_llegar()
        elif conv_con_flujo(cfg)
            flujo_anadir(flujo, http_flujo_leer(carga))
            mostrar_parcial()
        end
    elif estado == ORDEN
        if run_ready(orden_en_marcha)
            r = orden_acabar(orden_en_marcha)
            orden_en_marcha = 0
            poner_estado(PIDIENDO)
            resultado(r)
            seguir()
        end
    end
end

func parar()
    if estado == LIBRE
        return
    end
    if estado == PIDIENDO and carga != nil
        http_cancelar(carga)
        carga = nil
        resumiendo = nil
        parcial = false
    elif estado == ORDEN
        run_break(orden_en_marcha)
        resultado(orden_acabar(orden_en_marcha) + "\n[parada por el usuario]")
        orden_en_marcha = 0
    elif estado == PERMISO
        vista_responder(tr(57, "Parado"))
    end
    cerrar_pendientes("Parado por el usuario.")
    vista_anadir(QUIEN_AVISO, tr(14, "Parado."))
    poner_estado(LIBRE)
    refrescar()
end

# El tic de siempre: rápido mientras pasa algo
func tic()
    avanzar()
    if estado == PERMISO and prueba_permiso != ""
        tics_permiso = tics_permiso - 1
        if tics_permiso == 0
            if prueba_permiso == "No"
                responder_permiso(1)
            elif prueba_permiso == "Siempre"
                responder_permiso(2)
            else
                responder_permiso(0)
            end
        end
    end
    if estado == LIBRE and tics_cierre > 0
        tics_cierre = tics_cierre - 1
        if tics_cierre == CIERRE_PRUEBA_TICS - 1
            desde = env_get("INFERENCIA_PRUEBA_LINEA")
            if desde != ""
                vista_ir_a(Int(desde))
                refrescar()
            end
        end
    end
    if estado != LIBRE
        mui_timer(TIC_MS, EV_TIC)
    else
        mui_timer(TIC_QUIETO_MS, EV_TIC)
    end
end

func nueva_conversacion()
    parar()
    conv = conv_nueva(SISTEMA)
    herramientas_declarar(conv)
    vista_limpiar()
    contexto = ""
    tokens_entrada = 0
    tokens_salida = 0
    coste = 0
    poner_estado(LIBRE)
    refrescar()
end

# --- Preferencias ---

func _indice_proveedor(p: String) -> Int
    i = 0
    for n in str_split(PROVEEDORES, "|")
        if n == p
            return i
        end
        i = i + 1
    end
    return 0
end

func preferencias_abrir()
    mui_set_value(pref.proveedor, _indice_proveedor(cfg.proveedor))
    mui_set_text(pref.url, cfg.url)
    # la clave no se enseña: el campo es para una nueva
    mui_set_text(pref.clave, "")
    mui_set_text(pref.modelo, str_trim(mui_get_text(v.modelo)))
    mui_set_text(pref.tope, env_get("Inferencia/tope"))
    mui_window_open(pref.window)
end

# Al cambiar de proveedor, su dirección (si la que había era la de otro proveedor)
func preferencias_proveedor()
    nuevo = str_split(PROVEEDORES, "|")[mui_get_value(pref.proveedor)]
    url = str_trim(mui_get_text(pref.url))
    for p in str_split(PROVEEDORES, "|")
        if url == "" or url == config_url_de(p)
            mui_set_text(pref.url, config_url_de(nuevo))
        end
    end
end

# Usar (guardar = false) o Guardar (también en ENVARC:)
func preferencias_aplicar(guardar: Bool)
    cfg.proveedor = str_split(PROVEEDORES, "|")[mui_get_value(pref.proveedor)]
    cfg.url = str_trim(mui_get_text(pref.url))
    if cfg.url == ""
        cfg.url = config_url_de(cfg.proveedor)
    end
    nueva = str_trim(mui_get_text(pref.clave))
    if nueva != ""
        cfg.clave = nueva
    end
    mui_set_text(pref.clave, "")
    cfg.modelo = str_trim(mui_get_text(pref.modelo))
    mui_set_text(v.modelo, cfg.modelo)
    config_guardar(cfg, guardar)
    env_set("Inferencia/tope", str_trim(mui_get_text(pref.tope)), guardar)
    mui_window_close(pref.window)
    vista_anadir(QUIEN_AVISO, tr(16, "Proveedor: ") + cfg.proveedor + ", " + cfg.url + ".")
    refrescar()
end

# --- Guardar y abrir la conversación ---

func guardar_conversacion(fichero: String) -> Bool
    if file_write_text(fichero, conv_guardar(conv, cfg.modelo))
        vista_anadir(QUIEN_AVISO, tr(17, "Guardada en ") + fichero + ".")
        refrescar()
        return true
    end
    vista_anadir(QUIEN_AVISO, tr(18, "No se pudo guardar en ") + fichero + ".")
    refrescar()
    return false
end

func abrir_conversacion(fichero: String) -> Bool
    texto = file_read_text(fichero)
    var c: Conversacion = nil
    if texto != nil
        c = conv_cargar(texto, conv)
    end
    if c == nil
        vista_anadir(QUIEN_AVISO, fichero + tr(19, " no es una conversación de Inferencia."))
        refrescar()
        return false
    end
    parar()
    conv = c
    vista_limpiar()
    # la conversación se vuelve a ver: lo del usuario, lo del modelo y qué herramientas usó
    n = json_length(conv.mensajes)
    i = 1
    while i < n
        m = json_at(conv.mensajes, i)
        rol = json_get_str(m, "role")
        contenido = utf8_to_latin1(json_get_str(m, "content"))
        if rol == "user"
            if str_starts(contenido, "Resumen de la conversación")
                vista_anadir(QUIEN_AVISO, tr(20, "(resumen de lo anterior)"))
            else
                vista_anadir(QUIEN_USUARIO, contenido)
            end
        elif rol == "assistant"
            if contenido != "" and contenido != "De acuerdo."
                vista_anadir(QUIEN_MODELO, contenido)
            end
            llamadas = json_get(m, "tool_calls")
            if llamadas != nil
                k = 0
                while k < json_length(llamadas)
                    vista_anadir(QUIEN_HERRAMIENTA, json_path_str(json_at(llamadas, k), "function.name"))
                    k = k + 1
                end
            end
        end
        i = i + 1
    end
    vista_anadir(QUIEN_AVISO, tr(21, "Abierta ") + fichero + ".")
    tokens_entrada = 0
    tokens_salida = 0
    coste = 0
    poner_estado(LIBRE)
    refrescar()
    return true
end

# --- El puerto ARexx INFERENCIA.1 ---

# El argumento de una orden, sin las comillas de alrededor
func _argumento(linea: String) -> String
    p = str_find(linea, " ")
    if p < 0
        return ""
    end
    a = str_trim(linea[p + 1:])
    if a.length >= 2 and ((str_starts(a, "\"") and str_ends(a, "\"")) or (str_starts(a, "'") and str_ends(a, "'")))
        a = a[1:a.length - 1]
    end
    return a
end

# CONTEXTO fichero [desde hasta]: el fichero (o esas líneas) va con la siguiente pregunta
func _contexto(a: String) -> String
    fichero = a
    desde = 0
    hasta = 0
    if str_starts(a, "\"")
        q = str_find_from(a, "\"", 1)
        if q > 0
            fichero = a[1:q]
            a = str_trim(a[q + 1:])
        else
            a = ""
        end
    else
        partes = str_split(a, " ")
        fichero = partes[0]
        a = str_trim(a[fichero.length:])
    end
    if a != ""
        n = str_split(a, " ")
        desde = Int(n[0])
        if n.length > 1
            hasta = Int(n[1])
        end
    end
    texto = file_read_text(fichero)
    if texto == nil
        mui_rexx_fail(10)
        return ""
    end
    lineas = str_split(texto, "\n")
    que = fichero
    if desde > 0
        if hasta < desde or hasta > lineas.length
            hasta = lineas.length
        end
        texto = ""
        i = desde
        while i <= hasta
            texto = texto + lineas[i - 1] + "\n"
            i = i + 1
        end
        que = fichero + ", líneas #{desde} a #{hasta}"
    end
    contexto = contexto + "Contexto (" + que + "):\n```\n" + texto + "\n```\n\n"
    vista_anadir(QUIEN_HERRAMIENTA, tr(22, "Contexto: ") + que)
    refrescar()
    return ""
end

# Las órdenes ARexx que MUI no contesta solo (QUIT, SHOW, HIDE... sí las contesta)
func orden_rexx(linea: String) -> String
    primera = str_split(linea, "\n")[0]
    orden = str_upper(str_split(str_trim(primera), " ")[0])
    a = _argumento(linea)
    if orden == "PREGUNTA"
        if estado != LIBRE
            mui_rexx_fail(5)
            return ""
        end
        if a == ""
            mui_rexx_fail(10)
            return ""
        end
        enviar(a)
        return ""
    elif orden == "ESTADO"
        var nombres: [String] = ["libre", "pidiendo", "permiso", "orden"]
        return nombres[estado]
    elif orden == "RESPUESTA"
        if estado != LIBRE
            mui_rexx_fail(5)
            return ""
        end
        if ultimo_error != ""
            mui_rexx_fail(10)
            return ""
        end
        return ultima_respuesta
    elif orden == "CONTEXTO"
        return _contexto(a)
    elif orden == "ADJUNTAR"
        # "ADJUNTAR título" y el texto en las líneas siguientes (lo manda Forja)
        p = str_find(linea, "\n")
        if p < 0
            mui_rexx_fail(10)
            return ""
        end
        titulo = str_trim(primera[8:])
        contexto = contexto + "Contexto (" + titulo + "):\n```\n" + linea[p + 1:] + "\n```\n\n"
        vista_anadir(QUIEN_HERRAMIENTA, tr(23, "Contexto: ") + titulo)
        refrescar()
        return ""
    elif orden == "NUEVA"
        nueva_conversacion()
        return ""
    elif orden == "MOSTRAR"
        mui_window_open(v.window)
        return ""
    elif orden == "GUARDAR" or orden == "CARGAR"
        if a == "" or estado != LIBRE
            mui_rexx_fail(10)
            return ""
        end
        bien = false
        if orden == "GUARDAR"
            bien = guardar_conversacion(a)
        else
            bien = abrir_conversacion(a)
        end
        if not bien
            mui_rexx_fail(10)
        end
        return ""
    elif orden == "COSTE"
        return "#{tokens_entrada} #{tokens_salida} #{coste}"
    elif orden == "MENSAJES"
        return "#{conv_longitud(conv)}"
    elif orden == "OCULTAR"
        mui_window_close(v.window)
        return ""
    end
    mui_rexx_fail(10)
    return ""
end

Main
    cfg = config_leer()
    app = mui_app_begin("Inferencia", "INFERENCIA")
    if app == 0
        Print "Inferencia necesita MUI y un 68020 o mejor."
    else
        v = Principal_create()
        pref = Preferencias_create()
        mui_set_text(v.modelo, cfg.modelo)
        mui_canvas_on_draw(v.conversacion, dibujar)
        mui_canvas_on_input(v.conversacion, EV_LIENZO)
        mui_canvas_buffered(v.conversacion, true)
        mui_app_rexx(app, orden_rexx)
        permisos_leer()
        conv = conv_nueva(SISTEMA)
        herramientas_declarar(conv)
        vista_anadir(QUIEN_AVISO, tr(24, "Escribe abajo (Return: otra línea) y pulsa Enviar o Amiga+Return. Proveedor y modelo: Amiga-P."))
        mui_window_open(v.window)
        mui_set_active(v.window, v.entrada)
        sonda = env_get("INFERENCIA_SONDA") != ""
        poner_estado(LIBRE)
        ajustar_barra()
        mui_timer(TIC_QUIETO_MS, EV_TIC)

        prueba_permiso = env_get("INFERENCIA_PRUEBA_PERMISO")
        pregunta = env_get("INFERENCIA_PRUEBA")
        if str_starts(pregunta, "@")
            pregunta = str_trim(file_read_text(pregunta[1:]))
        end
        if pregunta != ""
            prueba = true
            enviar(pregunta)
        end

        while true
            ev = mui_wait_event_signals(task_signal())
            if ev == -1 or ev == EV_SALIR or tics_cierre == 0
                break
            end
            if ev == EV_TIC
                tic()
            elif ev == 0
                avanzar()
            elif ev == EV_ENVIAR
                texto = str_trim(mui_get_text(v.entrada))
                if texto != "" and estado == LIBRE
                    mui_set_text(v.entrada, "")
                    enviar(texto)
                end
                mui_set_active(v.window, v.entrada)
            elif ev == EV_PARAR
                parar()
            elif ev == EV_BARRA
                if mui_get_value(v.barra) != vista_primera
                    vista_ir_a(mui_get_value(v.barra))
                    mui_canvas_redraw(v.conversacion)
                end
            elif ev == EV_LIENZO
                rueda = mui_canvas_wheel(v.conversacion)
                if rueda != 0
                    vista_ir_a(vista_primera - rueda * 3)
                    mui_set_value(v.barra, vista_primera)
                    mui_canvas_redraw(v.conversacion)
                elif mui_canvas_button(v.conversacion) == 1 and estado == PERMISO
                    responder_permiso(vista_boton_en(mui_canvas_mouse_x(v.conversacion), mui_canvas_mouse_y(v.conversacion)))
                end
            elif ev == EV_NUEVA
                nueva_conversacion()
            elif ev == EV_PREFERENCIAS
                preferencias_abrir()
            elif ev == EV_PREF_PROVEEDOR
                preferencias_proveedor()
            elif ev == EV_PREF_GUARDAR or ev == EV_PREF_USAR
                preferencias_aplicar(ev == EV_PREF_GUARDAR)
            elif ev == EV_PREF_CANCELAR
                mui_window_close(pref.window)
            elif ev == EV_GUARDAR
                if file_save_dialog("Guardar la conversación", "#?.json")
                    guardar_conversacion(file_fullpath())
                end
            elif ev == EV_ABRIR
                if estado == LIBRE and file_open_dialog("Abrir una conversación", "#?.json")
                    abrir_conversacion(file_fullpath())
                end
            end
            ajustar_barra()
            if sonda
                publicar_sonda()
            end
        end
        if estado == PIDIENDO and carga != nil
            http_cancelar(carga)
        elif estado == ORDEN
            run_break(orden_en_marcha)
        end
        mui_app_end()
    end
    red_terminar()
end
