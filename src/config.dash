# La configuración de Inferencia: proveedor, dirección, clave y modelo.
#
# Se lee de ENV: (lo que el sistema copia de ENVARC: al arrancar). config_guardar la deja también en ENVARC:.
#   ENV:Inferencia/proveedor  openrouter (por defecto), anthropic, u openai: cualquiera con el formato de OpenAI
#                             Chat Completions (OpenAI, DeepSeek, Groq; Ollama o LM Studio en casa, sin clave)
#   ENV:Inferencia/url        la dirección; si no está, la del proveedor (con openai no hay una por defecto)
#   ENV:Inferencia/clave      la clave; si no está, ENV:OPENROUTER_API_KEY
#   ENV:Inferencia/modelo     el modelo
# Las variables sueltas INFERENCIA_URL e INFERENCIA_MODELO (de la prueba F0) también valen.

const URL_OPENROUTER = "https://openrouter.ai/api/v1/chat/completions"
const URL_ANTHROPIC = "https://api.anthropic.com/v1/messages"
const URL_OLLAMA = "http://localhost:11434/v1/chat/completions"
const MODELO_DEFECTO = "openrouter/auto"
const MODELO_ANTHROPIC = "claude-sonnet-5-5"

const PROVEEDORES = "openrouter|anthropic|openai"

struct Config
    url: String
    clave: String
    modelo: String
    proveedor: String = "openrouter"
end

func _config_una(nombre: String, suelta: String, defecto: String) -> String
    v = env_get("Inferencia/" + nombre)
    if v == "" and suelta != ""
        v = env_get(suelta)
    end
    if v == ""
        v = defecto
    end
    return str_trim(v)
end

# La dirección de un proveedor cuando no se da otra
func config_url_de(proveedor: String) -> String
    if proveedor == "anthropic"
        return URL_ANTHROPIC
    elif proveedor == "openai"
        return URL_OLLAMA
    end
    return URL_OPENROUTER
end

func config_leer() -> Config
    proveedor = str_lower(_config_una("proveedor", "", "openrouter"))
    if proveedor != "anthropic" and proveedor != "openai"
        proveedor = "openrouter"
    end
    url = _config_una("url", "INFERENCIA_URL", config_url_de(proveedor))
    clave = _config_una("clave", "OPENROUTER_API_KEY", "")
    defecto = MODELO_DEFECTO
    if proveedor == "anthropic"
        defecto = MODELO_ANTHROPIC
    end
    modelo = _config_una("modelo", "INFERENCIA_MODELO", defecto)
    c = Config(url, clave, modelo)
    c.proveedor = proveedor
    return c
end

# Guarda la configuración en ENV: y en ENVARC: (guardar = false: solo en ENV:, hasta reiniciar)
func config_guardar(c: Config, guardar: Bool)
    env_set("Inferencia/proveedor", c.proveedor, guardar)
    env_set("Inferencia/url", c.url, guardar)
    env_set("Inferencia/clave", c.clave, guardar)
    env_set("Inferencia/modelo", c.modelo, guardar)
end
