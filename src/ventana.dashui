{
  "dashui": 1,
  "windows": [
    {
      "name": "Principal",
      "tr": 200, "title": "Inferencia",
      "id": 1,
      "size": [60, 70],
      "menus": [
        {
          "tr": 201, "title": "Proyecto",
          "items": [
            { "tr": 202, "label": "Conversación nueva", "key": "N", "event": 20 },
            { "tr": 203, "label": "Abrir conversación...", "key": "O", "event": 22 },
            { "tr": 204, "label": "Guardar conversación...", "key": "S", "event": 21 },
            { "tr": 205, "label": "Preferencias...", "key": "P", "event": 23 },
            { "separator": true },
            { "tr": 206, "label": "Salir", "key": "Q", "event": 99 }
          ]
        }
      ],
      "root": {
        "type": "vgroup",
        "children": [
          {
            "type": "hgroup",
            "children": [
              { "type": "label", "tr": 207, "text": "Modelo:" },
              { "type": "string", "name": "modelo", "text": "", "max": 200, "weight": 180 },
              { "type": "text", "name": "estado", "text": "", "weight": 320 }
            ]
          },
          {
            "type": "hgroup",
            "children": [
              { "type": "canvas", "name": "conversacion", "min_width": 300, "min_height": 120, "weight": 300 },
              { "type": "scrollbar", "name": "barra", "vertical": true, "change": 3 }
            ]
          },
          {
            "type": "hgroup",
            "children": [
              { "type": "text_editor", "name": "entrada", "lines": 3, "ack": 1, "weight": 400 },
              {
                "type": "vgroup",
                "children": [
                  { "type": "button", "name": "enviar", "tr": {"label": 208, "help": 209}, "label": "_Enviar", "event": 1, "help": "Amiga+Return en el texto también lo manda" },
                  { "type": "button", "name": "parar", "tr": 210, "label": "_Parar", "event": 2, "disabled": true }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "name": "Preferencias",
      "tr": 211, "title": "Inferencia: preferencias",
      "id": 2,
      "close": 42,
      "root": {
        "type": "vgroup",
        "children": [
          {
            "type": "columns",
            "columns": 2,
            "children": [
              { "type": "label", "tr": 212, "text": "Proveedor:" },
              { "type": "cycle", "name": "proveedor", "tr": 213, "options": "OpenRouter|Anthropic|OpenAI y compatibles", "change": 43 },
              { "type": "label", "tr": 214, "text": "Dirección:" },
              { "type": "string", "name": "url", "text": "", "max": 300 },
              { "type": "label", "tr": 215, "text": "Clave nueva:" },
              { "type": "string", "name": "clave", "text": "", "max": 300 },
              { "type": "label", "tr": 216, "text": "Modelo:" },
              { "type": "string", "name": "modelo", "text": "", "max": 200 },
              { "type": "label", "tr": 217, "text": "Tope:" },
              { "type": "string", "name": "tope", "text": "", "max": 10 }
            ]
          },
          { "type": "text", "name": "nota", "tr": 218, "text": "Sin clave nueva, se queda la de ahora.\nTope: caracteres antes de resumir." },
          {
            "type": "hgroup",
            "children": [
              { "type": "button", "name": "guardar", "tr": 219, "label": "_Guardar", "event": 40 },
              { "type": "button", "name": "usar", "tr": 220, "label": "_Usar", "event": 41 },
              { "type": "space" },
              { "type": "button", "name": "cancelar", "tr": 221, "label": "_Cancelar", "event": 42 }
            ]
          }
        ]
      }
    }
  ]
}
